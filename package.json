{
  "private": true,
  "name": "my-game",
  "version": "0.1.0",
  "description": "A Colyseus multiplayer server",
  "type": "module",
  "engines": {
    "node": ">= 22.0.0"
  },
  "scripts": {
    "start": "vite",
    "loadtest": "tsx loadtest/example.ts --room dungeon --numClients 2",
    "build": "vite build",
    "clean": "rimraf dist",
    "test": "mocha -r tsx test/**.test.ts --exit --timeout 15000",
    "dev": "vite",
    "build:client": "vite build --mode client",
    "deploy:backend": "bash scripts/deploy-backend.sh",
    "deploy:frontend": "npm run build:client && npx wrangler@4 pages deploy dist/client --project-name one-prompt-game --branch main"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@colyseus/loadtest": "^0.18.1",
    "@colyseus/sdk": "^0.18.1",
    "@colyseus/testing": "^0.18.5",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.1",
    "@types/node": "^22.13.13",
    "@types/three": "^0.186.0",
    "mocha": "^11.7.5",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@colyseus/playground": "^0.18.3",
    "@colyseus/schema": "^5.0.14",
    "@colyseus/tools": "^0.18.1",
    "colyseus": "^0.18.2",
    "express": "^5.2.1",
    "three": "^0.186.1"
  }
}
